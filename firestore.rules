rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if resource.data.status == 'active' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /bodaRsvps/{docId} {
      allow create: if request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() < 500
        && request.resource.data.confirmacion is string
        && request.resource.data.telefono is string
        && request.resource.data.grupoInvitados is string;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
