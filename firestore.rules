rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isClient() {
      return isSignedIn() && userRole() == 'client';
    }

    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectOwner(projectId) {
      return isSignedIn() && projectData(projectId).ownerId == request.auth.uid;
    }

    function canManageProject(projectId) {
      return isAdmin() || isProjectOwner(projectId);
    }

    function activeProject(projectId) {
      return projectData(projectId).status == 'active';
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if resource.data.status == 'active' || isAdmin() || isProjectOwner(projectId);
      allow list: if isAdmin() || (isClient() && resource.data.ownerId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;

      match /links/{linkCode} {
        allow get: if isAdmin()
          || isProjectOwner(projectId)
          || (resource != null
              && resource.data.active == true
              && activeProject(projectId));
        allow list: if canManageProject(projectId);
        allow create: if canManageProject(projectId)
          && request.resource.data.guestLabel is string
          && request.resource.data.guestLabel.size() > 0
          && request.resource.data.cupos is number
          && request.resource.data.cupos >= 1
          && request.resource.data.active == true;
        allow update: if canManageProject(projectId);
        allow delete: if false;
      }
    }

    match /bodaRsvps/{docId} {
      allow create: if request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() < 500
        && request.resource.data.confirmacion is string
        && request.resource.data.telefono is string
        && request.resource.data.grupoInvitados is string;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
